# Bitcoin dormant detail pages: one template (address.html) renders ANY tracked
# address, reading it from /bitcoin-dormant/address/<ADDR>. Pre-rendered
# /bitcoin-dormant/address/<addr>.html files still win (Netlify serves an existing
# file before applying a 200 rewrite). Must precede the list splat below.
/bitcoin-dormant/address/*  /bitcoin-dormant/address.html     200

# Bitcoin dormant list pages. Pages 1..11 are pre-rendered files and are served
# directly (Netlify resolves /bitcoin-dormant/<N> to <N>.html before redirects); any
# other /bitcoin-dormant/<N> holds addresses.txt entries and renders from _page.html
# (bitcoin-dormant-fix.js reads the page number from the path + the txt slice).
/bitcoin-dormant/*          /bitcoin-dormant/_page.html       200

# Richest pages
/richest/:chain             /richest/:chain.html             200

# Private keys with key parameter
/private-keys/:chain/:rest  /private-keys/:chain/:rest       200

# Private key detail pages: one template (key.html) renders ANY key, reading the
# value from the /key/<value> path. Pre-rendered /key/<example> files still win
# (Netlify serves an existing file before applying a 200 rewrite).
/key/*                      /key.html                        200

# 404 fallback
/*                          /index.html                      200
